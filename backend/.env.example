# AI Employee Platform — Backend environment template
# Copy to .env. Never commit real secrets.

APP_NAME=AI Employee Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://aiep:aiep@localhost:5432/aiep
DATABASE_URL_SYNC=postgresql://aiep:aiep@localhost:5432/aiep
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STORAGE_DIR=./var/storage

AI_DEFAULT_PROVIDER=lm_studio
AI_DEFAULT_MODEL=google/gemma-4-e4b
AI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=

ANTHROPIC_API_KEY=

AI_MAX_TOOL_ITERATIONS=4
AI_AUTONOMY_MAX_STEPS=6

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_ALLOWED_RECIPIENT_DOMAINS=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_CLOSED=false

OUTBOX_MAX_ATTEMPTS=8
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-employee-platform
OTEL_EXPORTER_ENDPOINT=

BILLING_WEBHOOK_SECRET=
PLATFORM_ADMIN_EMAILS=

# RC5 Shopify OAuth
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/commerce-integrations/shopify/callback
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_customers,write_orders
SHOPIFY_API_VERSION=2026-07
FRONTEND_APP_URL=http://localhost:3000
STRIPE_TRIAL_DAYS=14
