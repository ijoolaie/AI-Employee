# AI Employee customer runtime configuration
# Copy to the deployment host as .env. Never commit the populated file.

APP_ENV=production
DEBUG=false

POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=<GENERATE_STRONG_SECRET>
POSTGRES_DB=ai_employee

SECRET_KEY=<GENERATE_STRONG_SECRET>
DATABASE_URL=postgresql+asyncpg://ai_employee:<URL_ENCODED_PASSWORD>@postgres:5432/ai_employee
DATABASE_URL_SYNC=postgresql://ai_employee:<URL_ENCODED_PASSWORD>@postgres:5432/ai_employee
REDIS_PASSWORD=<GENERATE_STRONG_SECRET>
REDIS_URL=redis://:<URL_ENCODED_REDIS_PASSWORD>@redis:6379/0
CELERY_BROKER_URL=redis://:<URL_ENCODED_REDIS_PASSWORD>@redis:6379/0
CELERY_RESULT_BACKEND=redis://:<URL_ENCODED_REDIS_PASSWORD>@redis:6379/1

CORS_ORIGINS=https://<CUSTOMER_DOMAIN>
FRONTEND_BASE_URL=https://<CUSTOMER_DOMAIN>
FRONTEND_APP_URL=https://<CUSTOMER_DOMAIN>
NEXT_PUBLIC_API_URL=https://<CUSTOMER_DOMAIN>/api

# Optional AI providers
LM_STUDIO_BASE_URL=https://ai.example.test/v1
LM_STUDIO_API_KEY=
ANTHROPIC_API_KEY=

# Optional outbound email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_ALLOWED_RECIPIENT_DOMAINS=

# Optional observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-employee-platform
OTEL_EXPORTER_ENDPOINT=

# Optional commercial integrations
BILLING_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MAP=
STRIPE_CHECKOUT_SUCCESS_URL=https://<CUSTOMER_DOMAIN>/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://<CUSTOMER_DOMAIN>/billing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://<CUSTOMER_DOMAIN>/billing
STRIPE_TRIAL_DAYS=14

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://<CUSTOMER_DOMAIN>/api/v1/commerce-integrations/shopify/callback
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_customers,write_orders
SHOPIFY_API_VERSION=2026-07
